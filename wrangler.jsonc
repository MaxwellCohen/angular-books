{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "angular-books-optimized",
  "main": "dist/angular-books/server/server.mjs",
  "compatibility_date": "2026-09-16",
  "alias": { "xhr2": "./workers/xhr2-stub.mjs" },
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/angular-books/browser",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "CATALOG_CACHE",
      "id": "888289c03b61403ab17f9279161625ce"
    }
  ]
}
