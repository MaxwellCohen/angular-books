{
  "buildCommand": "pnpm build",
  "framework": null,
  "outputDirectory": "dist/angular-books/browser",
  "functions": {
    "api/index.js": {
      "includeFiles": "dist/angular-books/server/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/media/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "ignoreCommand": "case \"$VERCEL_PROJECT_PRODUCTION_URL\" in \"\") false;; *-optimized*) [ \"$VERCEL_GIT_COMMIT_REF\" != optimized ];; *) [ \"$VERCEL_GIT_COMMIT_REF\" != main ];; esac",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true,
      "optimized": true
    }
  }
}
